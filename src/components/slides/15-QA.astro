---
---
<section class="slide split-layout reverse">
  <div class="split-img">
    <img src="/images/deus_final_dawn.jpg" alt="Илья Кадацкий — FINN FLARE" />
  </div>
  <div class="split-text">
    <h2 class="neon-cyan" style="font-size: 3.2rem; margin-bottom: 0.5rem; letter-spacing: -0.01em;">Илья Кадацкий</h2>
    <p style="font-size: 1.45rem; color: var(--sega-blue); margin-bottom: 2.2rem; font-weight: 600;">Руководитель по&nbsp;цифровому развитию FINN&nbsp;FLARE</p>
    
    <div class="bullet-list">
      <div class="bullet-item">
        <div style="display: flex; align-items: center; gap: 2.2rem;">
          <div style="flex-shrink: 0;">
            <img src="/images/qr_dark.png" alt="Telegram @IVKADATSKY" style="width: 200px; height: 200px; display: block; filter: drop-shadow(0 0 16px rgba(212, 175, 55, 0.25));" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.55rem;">
            <span class="qr-handle" style="font-family: 'Share Tech Mono', monospace; font-size: 1.85rem; font-weight: 700; color: var(--pip-green); text-shadow: var(--gg);">@IVKADATSKY</span>
            <p style="font-size: 1.3rem; line-height: 1.45; color: var(--text); margin: 0;">Презентация и&nbsp;связь в&nbsp;Telegram</p>
            <span style="font-family: 'Share Tech Mono', monospace; font-size: 1.25rem; color: var(--sega-blue); margin-top: 0.2rem;">t.me/IVKADATSKY</span>
          </div>
        </div>
      </div>

      <div class="bullet-item" style="margin-top: 2rem;">
        <h3 class="neon-magenta" style="font-size: 2.6rem; margin: 0; font-weight: 800; letter-spacing: 0.02em;">Вопросы?</h3>
      </div>
    </div>
  </div>
</section>
