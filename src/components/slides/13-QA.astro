---
---
<section class="slide split-layout reverse">
  <div class="split-img">
    <img src="/images/deus_final_dawn.jpg" alt="Второе дыхание бизнеса — Финал" />
  </div>
  <div class="split-text">
    <h2 class="neon-cyan">Второе дыхание бизнеса</h2>
    <h3 style="font-size: 1.65rem; color: var(--dim); margin-top: 0.8rem; margin-bottom: 2.2rem;">Вопросы и&nbsp;обсуждение</h3>
    
    <div class="bullet-list">
      <div class="bullet-item">
        <h3 class="neon-magenta" style="font-size: 1.85rem; margin-bottom: 0.35rem;">Илья Кадацкий</h3>
        <p style="font-size: 1.35rem; color: var(--dim); margin-bottom: 0;">Chief Product Architect &bull; FINN&nbsp;FLARE</p>
      </div>

      <div class="bullet-item glow-box border-green" style="margin-top: 0.6rem;">
        <div style="display: flex; align-items: center; gap: 1.8rem;">
          <div class="qr-box" style="flex-shrink: 0; background: #ffffff; padding: 10px; border-radius: 8px; box-shadow: 0 0 20px rgba(212, 175, 55, 0.35);">
            <img src="/images/qr_square.png" alt="Telegram @IVKADATSKY" style="width: 140px; height: 140px; display: block;" />
          </div>
          <div style="display: flex; flex-direction: column; gap: 0.45rem;">
            <span class="qr-handle" style="font-family: 'Share Tech Mono', monospace; font-size: 1.65rem; font-weight: 700; color: var(--pip-green); text-shadow: var(--gg);">@IVKADATSKY</span>
            <p style="font-size: 1.25rem; line-height: 1.45; color: var(--text); margin: 0;">Презентация, вопросы и&nbsp;нетворкинг в&nbsp;Telegram</p>
            <span style="font-family: 'Share Tech Mono', monospace; font-size: 1.2rem; color: var(--sega-blue); margin-top: 0.2rem;">t.me/IVKADATSKY</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
