---
import '../styles/theme.css';
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="ru">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
</head>
<body>

<div class="slides-track">
  <slot />
</div>

<!-- Unified Persistent Footer: Navigation + Branding across all slides -->
<footer class="presentation-footer">
  <div class="footer-left">
    <button class="nav-btn nav-prev hidden" aria-label="Предыдущий слайд">◀</button>
    <img src="/oborot_logo_white.png" class="footer-logo logo-oborot" alt="Оборот.ру" />
    <img src="/et26_logo_white.png" class="footer-logo logo-et26" alt="Электронная торговля’26" />
  </div>

  <div class="footer-center">
    <span class="footer-speaker">Илья Кадацкий</span>
    <span class="footer-counter hidden">
      <span class="nav-counter-current">01</span><span class="counter-sep">/</span><span class="nav-counter-total">13</span>
    </span>
  </div>

  <div class="footer-right">
    <img src="/ff_logo_white.svg" class="footer-logo logo-ff" alt="FINN FLARE" />
    <button class="nav-btn nav-next" aria-label="Следующий слайд">▶</button>
  </div>
</footer>

<script is:inline src="/slides.js"></script>
</body>
</html>
